<UserControl x:Class="AV.Playout.Controls.CompositorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        The program layer stack. DataContext is the PlayoutEngine.
        The inner Grid is the program canvas at its native raster; the Viewbox fits it
        to the LED output and, scaled down, to the operator's monitor.
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True">

            <!-- 0: background colour -->
            <Rectangle Fill="{Binding Background}" />

            <!-- 1: media (stills now, video frames in Phase 2) -->
            <Image Source="{Binding Media.Source}"
                   Opacity="{Binding Media.Opacity}"
                   Visibility="{Binding Media.IsVisible, Converter={StaticResource BoolToVis}}"
                   Stretch="Uniform" />

            <!-- 2: live input (NDI / capture, Phase 4) -->
            <Image Source="{Binding Live.Source}"
                   Opacity="{Binding Live.Opacity}"
                   Visibility="{Binding Live.IsVisible, Converter={StaticResource BoolToVis}}"
                   Stretch="Uniform" />

            <!-- 3: graphics with alpha (clocks, timers, Phase 5) -->
            <Image Source="{Binding Graphics.Source}"
                   Opacity="{Binding Graphics.Opacity}"
                   Visibility="{Binding Graphics.IsVisible, Converter={StaticResource BoolToVis}}"
                   Stretch="Uniform" />
        </Grid>
    </Viewbox>
</UserControl>
