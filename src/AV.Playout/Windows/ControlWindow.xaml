<Window x:Class="AV.Playout.Windows.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AV.Playout.Controls"
        Title="AV Playout — Control"
        Width="1280" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>

        <!-- ═════ Top bar: output routing ═════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Output display" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                    <ComboBox x:Name="DisplayCombo" Width="300" VerticalAlignment="Center"
                              SelectionChanged="DisplayCombo_SelectionChanged" />
                    <CheckBox x:Name="RehearsalCheck" Content="Windowed (rehearsal)"
                              Foreground="{StaticResource TextBrush}"
                              VerticalAlignment="Center" Margin="14,0"
                              Click="RehearsalCheck_Click" />
                    <ToggleButton x:Name="OutputToggle" Style="{StaticResource LiveToggle}"
                                  Checked="OutputToggle_Checked"
                                  Unchecked="OutputToggle_Unchecked"
                                  ToolTip="Show / hide the program output (Ctrl+F12 pulls it instantly)" />
                </StackPanel>
                <TextBlock Text="AV PLAYOUT" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ═════ Status bar ═════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="RenderTierText" DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <!-- ═════ Main area ═════ -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- Sources -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="BACKGROUND" />
                <ItemsControl x:Name="SwatchList" DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="52" Height="52" Margin="0,0,8,8" Padding="0"
                                    ToolTip="{Binding}" Click="Swatch_Click">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding}" />
                                </Button.Background>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+ Add stills…" Click="AddStills_Click" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="STILLS" Margin="0" />
                </DockPanel>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                        AllowDrop="True" DragOver="Bin_DragOver" Drop="Bin_Drop">
                    <Grid>
                        <TextBlock Text="Drop images here, or use + Add stills…"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=StillsList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StillsList" Margin="10,10,2,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8" Padding="0"
                                                ToolTip="{Binding FilePath}" Click="Still_Click">
                                            <Grid Width="160">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="90" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="Black" CornerRadius="4,4,0,0">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="8,5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Tally: red frame while on air -->
                                                <Border Grid.RowSpan="2" CornerRadius="4"
                                                        BorderBrush="{StaticResource TallyBrush}" BorderThickness="3"
                                                        Visibility="{Binding IsOnAir, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Program monitor -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="PROGRAM" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Clear media" Click="ClearMedia_Click" Margin="0,0,8,0" />
                    <Button Content="BLACKOUT" Style="{StaticResource DangerButton}" Click="Blackout_Click" />
                </StackPanel>
                <Border Background="Black" BorderBrush="{StaticResource TallyBrush}" BorderThickness="2">
                    <Grid>
                        <controls:CompositorView x:Name="ProgramMonitor" />
                        <TextBlock Text="PGM" Margin="8,6" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TallyBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
