<Window x:Class="AV.Playout.Windows.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AV.Playout.Controls"
        Title="AV Playout"
        Width="1600" Height="940" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Bg0}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ═════ Clip slot (one cell of the grid) ═════ -->
        <DataTemplate x:Key="SlotTemplate">
            <Border x:Name="Card" Width="156" Height="100" Margin="2" CornerRadius="3"
                    Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="2"
                    Cursor="Hand" AllowDrop="True" ToolTip="{Binding Source}"
                    MouseLeftButtonDown="Slot_MouseLeftButtonDown"
                    MouseRightButtonDown="Slot_MouseRightButtonDown"
                    DragOver="Slot_DragOver" Drop="Slot_Drop">
                <Grid ClipToBounds="True">
                    <TextBlock Text="+" FontSize="22" Foreground="{StaticResource Faint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Live sources have no thumbnail: show a big glyph -->
                    <TextBlock x:Name="LiveGlyph" Text="● LIVE" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource Muted}" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14" />

                    <TextBlock Text="loading…" Foreground="{StaticResource Muted}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                    <!-- kind glyph, top-left -->
                    <Border Background="#C0000000" CornerRadius="2" Padding="4,0" Margin="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding KindGlyph}" FontSize="9" Foreground="{StaticResource Text}" />
                    </Border>

                    <!-- hotkey badge, top-right -->
                    <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Bg4}" BorderThickness="1"
                            CornerRadius="2" Padding="4,0" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding HotkeyText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding HotkeyText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    </Border>

                    <!-- mode badge -->
                    <Border x:Name="ModeBadge" Background="{StaticResource Cue}" CornerRadius="2" Padding="4,0"
                            Margin="4,4,4,22" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="{Binding ModeText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ModeText}" FontSize="8" FontWeight="Bold" Foreground="Black" />
                    </Border>

                    <!-- name strip -->
                    <Border VerticalAlignment="Bottom" Background="#C0000000" Padding="6,2"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" />
                    </Border>

                    <Border x:Name="PlayTint" Background="{StaticResource AccentDim}" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Live">
                    <Setter TargetName="LiveGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Bg3}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Bg4}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCued}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Cue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="PlayTint" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Card" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═════ Layer header (left of each row) ═════ -->
        <DataTemplate x:Key="LayerHeaderTemplate">
            <Border Width="230" Height="100" Margin="0,2,6,2" CornerRadius="3"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="3,0,0,3" Background="{Binding AccentBrush}" />
                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource BypassToggle}" IsChecked="{Binding Bypass}" Margin="0,0,4,0"
                                              ToolTip="Bypass: take this layer off air without stopping it" />
                                <Button Style="{StaticResource IconButton}" Content="✕" Click="ClearLayer_Click"
                                        ToolTip="Clear layer (fades out)" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding ActiveSlot.Name, FallbackValue='—'}" Foreground="{StaticResource Muted}"
                                   FontSize="11" Margin="0,6,0,8" TextTrimming="CharacterEllipsis" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityPercent}" Width="34" TextAlignment="Right"
                                       Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" />
                            <Slider Style="{StaticResource Fader}" Value="{Binding Opacity}" Foreground="{Binding AccentBrush}"
                                    ToolTip="Layer opacity" />
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="200" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════════ Top bar ═════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="AV" FontWeight="Black" FontSize="14" Foreground="Black" />
                    </Border>
                    <TextBlock Text="PLAYOUT" FontWeight="Bold" FontSize="14" Margin="7,0,28,0" VerticalAlignment="Center" />

                    <TextBlock Text="OUTPUT" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                    <ComboBox x:Name="DisplayCombo" Width="250" SelectionChanged="DisplayCombo_SelectionChanged" />
                    <ToggleButton x:Name="RehearsalToggle" Style="{StaticResource Toggle}" Content="WINDOWED" Height="28"
                                  Margin="6,0" Click="RehearsalToggle_Click"
                                  ToolTip="Rehearsal: show the output in a normal window instead of fullscreen" />
                    <ToggleButton x:Name="OutputToggle" Style="{StaticResource LiveToggle}"
                                  Checked="OutputToggle_Checked" Unchecked="OutputToggle_Unchecked"
                                  ToolTip="Show / hide the program output. Ctrl+F12 pulls it instantly." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="GlobalKeysToggle" Style="{StaticResource Toggle}" Content="⌨  GLOBAL KEYS"
                                  Height="28" Margin="0,0,20,0" Click="GlobalKeysToggle_Click"
                                  ToolTip="Clip hotkeys fire even when another application has focus (for USB macro keypads)" />

                    <TextBlock Text="FADE" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                    <Slider Style="{StaticResource Fader}" Width="110" Maximum="3" VerticalAlignment="Center"
                            Value="{Binding CrossfadeSeconds}" ToolTip="Crossfade time for every trigger" />
                    <TextBlock Text="{Binding CrossfadeText}" Width="40" TextAlignment="Right" FontWeight="SemiBold"
                               VerticalAlignment="Center" FontFamily="{StaticResource NumFont}" />

                    <TextBlock Text="MASTER" Style="{StaticResource Caption}" Margin="20,0,8,0" />
                    <Slider Style="{StaticResource Fader}" Width="130" VerticalAlignment="Center"
                            Foreground="{StaticResource Tally}" Value="{Binding MasterOpacity}" ToolTip="Master fade to black" />
                    <TextBlock Text="{Binding MasterPercent}" Width="42" TextAlignment="Right" FontWeight="SemiBold"
                               VerticalAlignment="Center" FontFamily="{StaticResource NumFont}" />

                    <Button Style="{StaticResource DangerButton}" Content="BLACKOUT" Height="30" Padding="16,0"
                            Margin="16,0,0,0" Click="Blackout_Click" ToolTip="Fade every layer out, scorebug off, background black" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- ═════════════ Clip grid ═════════════ -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
                <!-- Column triggers -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Width="236" Text="LAYERS" Style="{StaticResource Caption}" Margin="2,0,0,0" />
                    <ItemsControl ItemsSource="{Binding ColumnNumbers}" ItemsPanel="{StaticResource HorizontalPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="156" Height="22" Margin="2,0" Padding="0" Content="{Binding}" Tag="{Binding}"
                                        Background="{StaticResource Bg1}" Click="Column_Click"
                                        ToolTip="Trigger this whole column" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Layers, top of the stack first (as in Resolume) -->
                <ItemsControl ItemsSource="{Binding LayersTopDown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LayerHeaderTemplate}" />
                                <ItemsControl ItemsSource="{Binding Slots}" ItemsPanel="{StaticResource HorizontalPanel}"
                                              ItemTemplate="{StaticResource SlotTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Background colour row -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Width="230" Height="44" Margin="0,2,6,2" CornerRadius="3"
                            Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="3,0,0,3" Background="{StaticResource Faint}" />
                            <TextBlock Text="BACKGROUND" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="10,0" />
                        </DockPanel>
                    </Border>
                    <ItemsControl x:Name="SwatchList" ItemsPanel="{StaticResource HorizontalPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="76" Height="44" Margin="2" Padding="0" Click="Swatch_Click" ToolTip="{Binding}">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding}" />
                                    </Button.Background>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="{StaticResource Line}" Focusable="False" />

        <!-- ═════════════ Bottom: properties | preview | program ═════════════ -->
        <Grid Grid.Row="3" Background="{StaticResource Bg1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="{StaticResource Line}" />
            <Border Grid.Column="3" Background="{StaticResource Line}" />

            <!-- Properties -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <RadioButton x:Name="ClipTab" Style="{StaticResource Tab}" Content="CLIP" IsChecked="True" />
                        <RadioButton x:Name="ScoreTab" Style="{StaticResource Tab}" Content="SCOREBOARD" />
                    </StackPanel>
                </Border>

                <Grid Margin="14,12">
                    <!-- CLIP -->
                    <Grid Visibility="{Binding IsChecked, ElementName=ClipTab, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"
                                   Visibility="{Binding SelectedSlot, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                            Click a slot to select it.<LineBreak />
                            Drop video / image files onto slots to load them.<LineBreak />
                            <LineBreak />
                            Left click: trigger to program<LineBreak />
                            Right click: cue to preview (pre-buffered)<LineBreak />
                            Double click an empty slot: browse for media
                        </TextBlock>

                        <Grid DataContext="{Binding SelectedSlot}"
                              Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.ColumnSpan="2" FontWeight="Bold" FontSize="13" Margin="0,0,0,10">
                                <Run Text="{Binding Layer, Mode=OneWay}" /><Run Text="  ·  SLOT " Foreground="{StaticResource Muted}" /><Run Text="{Binding ColumnNumber, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Row="1" Text="NAME" Style="{StaticResource Caption}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Text="SOURCE" Style="{StaticResource Caption}" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                                <Button DockPanel.Dock="Right" Content="CAMERA" Margin="4,0,0,0" Click="Camera_Click"
                                        ToolTip="Default capture device (webcam, capture card, Blackmagic via DirectShow)" />
                                <Button DockPanel.Dock="Right" Content="…" Margin="4,0,0,0" Click="Browse_Click" ToolTip="Browse for a file" />
                                <TextBox x:Name="SourceBox" Text="{Binding Source, Mode=OneWay}" KeyDown="SourceBox_KeyDown"
                                         ToolTip="File path, or a stream URL (rtsp://, srt://, udp://, dshow://). Press Enter to load." />
                            </DockPanel>

                            <TextBlock Grid.Row="3" Text="MODE" Style="{StaticResource Caption}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <RadioButton Style="{StaticResource Segment}" Content="LOOP"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Loop}"
                                             ToolTip="Loop until something else is triggered" />
                                <RadioButton Style="{StaticResource Segment}" Content="ONCE"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Once}"
                                             ToolTip="Play once, then fade the layer out" />
                                <RadioButton Style="{StaticResource Segment}" Content="TAKEOVER"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Takeover}"
                                             ToolTip="Play once over everything (live feed pulled, scorebug stays), then restore" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="HOTKEY" Style="{StaticResource Caption}" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Bg4}" BorderThickness="1"
                                        CornerRadius="3" MinWidth="90" Padding="8,4">
                                    <TextBlock x:Name="HotkeyText" Text="{Binding HotkeyText, TargetNullValue='none'}"
                                               FontWeight="Bold" FontFamily="{StaticResource NumFont}" />
                                </Border>
                                <Button x:Name="AssignHotkeyButton" Content="ASSIGN" Margin="4,0,0,0" Click="AssignHotkey_Click"
                                        ToolTip="Then press a key on the keyboard or macro keypad. F13–F24 are ideal." />
                                <Button Content="✕" Margin="4,0,0,0" Click="ClearHotkey_Click" ToolTip="Remove hotkey" />
                            </StackPanel>

                            <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Top">
                                <Button Content="CUE ▸ PREVIEW" Margin="0,0,6,6" Click="CueSelected_Click" />
                                <Button Style="{StaticResource AccentButton}" Content="TRIGGER" Margin="0,0,6,6" Click="TriggerSelected_Click" />
                                <Button Content="CLEAR SLOT" Margin="0,0,6,6" Click="ClearSlot_Click" />
                            </WrapPanel>
                        </Grid>
                    </Grid>

                    <!-- SCOREBOARD -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=ScoreTab, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Scoreboard}">
                            <DockPanel Margin="0,0,0,10">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle}" Content="SHOW ON OUTPUT"
                                              IsChecked="{Binding IsVisible}" Height="26" />
                                <TextBlock Text="SCOREBUG" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Text="{Binding HomeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" BorderBrush="#FFD7262E" />
                                <Button Grid.Column="1" Content="−" Width="28" Margin="6,3,0,3" Tag="HomeMinus" Click="Score_Click" />
                                <TextBlock Grid.Column="2" Text="{Binding HomeScore}" FontSize="24" FontWeight="Bold"
                                           FontFamily="{StaticResource NumFont}" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="+ GOAL" Margin="0,3" Tag="HomeGoal" Click="Score_Click" />
                                <Button Grid.Column="4" Content="+2:00" Margin="6,3,0,3" Tag="HomePenalty" Click="Score_Click"
                                        ToolTip="Add a 2-minute penalty" />

                                <TextBox Grid.Row="1" Text="{Binding AwayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" BorderBrush="#FF2A5FE0" />
                                <Button Grid.Row="1" Grid.Column="1" Content="−" Width="28" Margin="6,3,0,3" Tag="AwayMinus" Click="Score_Click" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AwayScore}" FontSize="24" FontWeight="Bold"
                                           FontFamily="{StaticResource NumFont}" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="3" Content="+ GOAL" Margin="0,3" Tag="AwayGoal" Click="Score_Click" />
                                <Button Grid.Row="1" Grid.Column="4" Content="+2:00" Margin="6,3,0,3" Tag="AwayPenalty" Click="Score_Click"
                                        ToolTip="Add a 2-minute penalty" />
                            </Grid>

                            <Border Background="{StaticResource Bg0}" CornerRadius="3" Margin="0,12,0,0" Padding="12,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="80" Height="30" Tag="ToggleClock" Click="Score_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                    <Setter Property="Content" Value="▶ START" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Content" Value="❚❚ STOP" />
                                                            <Setter Property="Background" Value="{StaticResource TallyDim}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Tally}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="RESET" Height="30" Margin="6,0,0,0" Tag="ResetClock" Click="Score_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ClockText}" FontSize="34" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource NumFont}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="◂" Padding="6,0" Tag="PreviousPeriod" Click="Score_Click" />
                                            <TextBlock Text="{Binding PeriodText}" Width="40" TextAlignment="Center" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            <Button Content="▸" Padding="6,0" Tag="NextPeriod" Click="Score_Click" />
                                            <TextBlock Text="PERIOD MIN" Style="{StaticResource Caption}" Margin="14,0,6,0" />
                                            <TextBox Width="44" Text="{Binding PeriodMinutes}" Padding="4,1" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding HomePenalties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource Cue}" FontWeight="Bold"
                                                           FontFamily="{StaticResource NumFont}" Width="44" VerticalAlignment="Center" />
                                                <Button Content="✕" Padding="5,0" Click="RemovePenalty_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding AwayPenalties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource Cue}" FontWeight="Bold"
                                                           FontFamily="{StaticResource NumFont}" Width="44" VerticalAlignment="Center" />
                                                <Button Content="✕" Padding="5,0" Click="RemovePenalty_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Preview -->
            <DockPanel Grid.Column="2" Margin="12,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Height="28">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="TAKE ▸" Padding="18,0"
                            Click="Take_Click" ToolTip="Take the cued clip to program" />
                    <TextBlock Text="PREVIEW" Style="{StaticResource Caption}" Foreground="{StaticResource Cue}" />
                    <TextBlock Text="{Binding CuedSlot.Name, FallbackValue=''}" Margin="10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Border Background="Black" BorderBrush="{StaticResource Cue}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                        <TextBlock Text="Right-click a slot to cue it here" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding CuedSlot, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Program -->
            <DockPanel Grid.Column="4" Margin="12,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Height="28">
                    <Border DockPanel.Dock="Right" Background="{StaticResource Cue}" CornerRadius="3" Padding="8,2"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsTakeoverActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="TAKEOVER" FontSize="10" FontWeight="Bold" Foreground="Black" />
                    </Border>
                    <TextBlock Text="PROGRAM" Style="{StaticResource Caption}" Foreground="{StaticResource Tally}" />
                </DockPanel>
                <Border Background="Black" BorderBrush="{StaticResource Tally}" BorderThickness="1">
                    <c:CompositorView x:Name="ProgramMonitor" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- ═════════════ Status bar ═════════════ -->
        <Border Grid.Row="4" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="RenderTierText" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11" />
                <TextBlock x:Name="KeysText" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,0,20,0"
                           Text="Ctrl+F12 pulls the output" />
                <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Muted}" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
